FROM cgr.dev/chainguard/busybox:latest@sha256:af8a76603d162a643e8c49cae2afe21ed6389c376fb6b4bb3228dbc2d2fad7f6

ARG TARGETPLATFORM

COPY ${TARGETPLATFORM}/gasa /usr/bin/gasa

# run as distroless-style nonroot user/group (uid/gid 65532) in final image
USER 65532:65532

# checkov:skip=CKV_DOCKER_2: HEALTHCHECK is not applicable to a CLI-only image
ENTRYPOINT ["/usr/bin/gasa"]
CMD ["--help"]
