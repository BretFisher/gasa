# Super-linter linter enable/disable settings.
# Prefer adding per-linter toggles here rather than in the extra-envs input of lint.yml.
# See: https://github.com/super-linter/super-linter#environment-variables

# JSCPD reports repository-wide duplication that blocks this repo despite being non-actionable for lint quality.
VALIDATE_JSCPD=false

# TRIVY enforces container healthcheck policies that are not applicable to this CLI-only image.
VALIDATE_TRIVY=false
