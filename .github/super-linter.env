# Super-linter linter enable/disable settings.
# Prefer adding per-linter toggles here rather than in the extra-envs input of lint.yml.
# See: https://github.com/super-linter/super-linter#environment-variables

# JSCPD reports repository-wide duplication that blocks this repo despite being non-actionable for lint quality.
VALIDATE_JSCPD=false

# TRIVY enforces container healthcheck policies that are not applicable to this CLI-only image.
VALIDATE_TRIVY=false

# The other markdown linter is enough.
VALIDATE_MARKDOWN_PRETTIER=false

# The file-based GO linter passes changed files directly to golangci-lint, which
# fails ("named files must all be in one directory") when a PR touches more than
# one package (e.g. cmd and internal/scanner). GO_MODULES runs golangci-lint
# at the module level instead, covering the same checks without that limitation.
VALIDATE_GO=false

# Biome formats JS/TS/JSON. This repository is a Go CLI whose only JSON is
# end-to-end test fixture data and generated golden files, and Biome scans the
# whole workspace rather than honouring FILTER_REGEX_EXCLUDE. Re-enable if real
# JavaScript, TypeScript, or hand-maintained JSON is added.
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
